// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s --implicit-check-not=Error --implicit-check-not=Warning

import core::convert;

fn buffer_index(row : i64, rows : i64, dims : i64, d : i64) -> i64
requires rows > 0 && rows <= 2147483647 && dims > 0 && dims <= 2147483647
requires row >= 0 && row < rows && d >= 0 && d < dims
ensures return >= 0 && return < rows * dims {
  return row * dims + d;
}

fn index_from_i32(row : i32, rows : i32, dims : i32, d : i32) -> i64
requires rows > 0 && dims > 0 && row >= 0 && row < rows && d >= 0 && d < dims {
  return buffer_index(i64::from(row), i64::from(rows), i64::from(dims), i64::from(d));
}

fn main() -> i32 {
  return index_from_i32(2, 4, 128, 5) as i32;
}

// CHECK: module attributes {vx.drops} {
// CHECK:   func.func private @vx_init_signals()
// CHECK:   func.func @main() -> i32 {
// CHECK:     call @vx_init_signals() : () -> ()
// CHECK:     %c2_i32 = arith.constant 2 : i32
// CHECK:     %c4_i32 = arith.constant 4 : i32
// CHECK:     %c128_i32 = arith.constant 128 : i32
// CHECK:     %c5_i32 = arith.constant 5 : i32
// CHECK:     %0 = call @index_from_i32(%c2_i32, %c4_i32, %c128_i32, %c5_i32) : (i32, i32, i32, i32) -> i64
// CHECK:     %1 = arith.trunci %0 : i64 to i32
// CHECK:     return %1 : i32
// CHECK:   }
// CHECK:   func.func @index_from_i32(%arg0: i32, %arg1: i32, %arg2: i32, %arg3: i32) -> i64 {
// CHECK:     %0 = call @"i64::From$i32$from"(%arg0) : (i32) -> i64
// CHECK:     %1 = call @"i64::From$i32$from"(%arg1) : (i32) -> i64
// CHECK:     %2 = call @"i64::From$i32$from"(%arg2) : (i32) -> i64
// CHECK:     %3 = call @"i64::From$i32$from"(%arg3) : (i32) -> i64
// CHECK:     %4 = call @buffer_index(%0, %1, %2, %3) : (i64, i64, i64, i64) -> i64
// CHECK:     return %4 : i64
// CHECK:   }
// CHECK:   func.func @"i64::From$i32$from"(%arg0: i32) -> i64 {
// CHECK:     %0 = arith.extsi %arg0 : i32 to i64
// CHECK:     return %0 : i64
// CHECK:   }
// CHECK:   func.func @buffer_index(%arg0: i64, %arg1: i64, %arg2: i64, %arg3: i64) -> i64 {
// CHECK:     %0 = arith.muli %arg0, %arg2 : i64
// CHECK:     %1 = arith.addi %0, %arg3 : i64
// CHECK:     return %1 : i64
// CHECK:   }
// CHECK: }
