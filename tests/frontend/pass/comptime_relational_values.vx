// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

fn main() -> i32 {
  let float_value = comptime {
    if 1.5 < 2.0 {
      7i32
    } else {
      0i32
    }
  };
  let bool_value = comptime {
    if true != false {
      1i32
    } else {
      0i32
    }
  };
  let topology_value = comptime {
    if Topology::CPU == Topology::CPU {
      4i32
    } else {
      0i32
    }
  };
  return float_value + bool_value + topology_value;
}

// CHECK-LABEL: func.func @main() -> i32
// CHECK: arith.constant 7 : i32
// CHECK: arith.constant 1 : i32
// CHECK: arith.constant 4 : i32
