// RUN: vxc %s --action emit-mlir 2>&1 | FileCheck %s

fn copy(value : i32) -> i32 {
  return value;
}

fn main() -> i32 {
  let value = comptime {
    let mut result = 0i32;
    for i in 0i32..200000i32 {
      result = copy(i);
    }
    result
  };
  return value;
}

// CHECK-LABEL: func.func @main() -> i32
// CHECK: arith.constant 199999 : i32
