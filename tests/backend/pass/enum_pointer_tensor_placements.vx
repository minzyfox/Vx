// Pointer targets in different memories need different enum instances.
// Repeated host instances must also agree across source locations.
// REQUIRES: flat-codegen
// EXPECT: 3

enum Opt<T> {
  Some(T), None
}
fn _first(x: Opt<*const Tensor<f32, [4]>>) -> i32 {
  return 1;
}
fn _second(x: Opt<*const Tensor<f32, [4], Memory::GPU_HBM>>) -> i32 {
  return 2;
}
fn _third(x: Opt<*const Tensor<f32, [4]>>) -> i32 {
  return 1;
}
fn main() -> i32 {
  print(3); return 0;
}
